{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minicafe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-29",
  "account_id": "eb287aa685065bca39c8b9bb5f5f97c3",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "PUBLIC_TEST_MODE": "true" },
  "d1_databases": [{"binding":"DB","database_name":"minicafe-db","database_id":"07db3dbb-3b7b-4382-8ebd-2c3460c3fea6","migrations_dir":"migrations"}],
  "observability": { "enabled": false }
}
