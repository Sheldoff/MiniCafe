{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "minicafe",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-29",
  "account_id": "eb287aa685065bca39c8b9bb5f5f97c3",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*",
      "/auth/*",
      "/admin",
      "/admin/*",
      "/private/*",
    ],
  },
  "vars": {
    "ADMIN_TELEGRAM_IDS": "600810855,1402380598",
    "TELEGRAM_CLIENT_ID": "9119381884",
    "TELEGRAM_BOT_USERNAME": "minicafe_loginbot",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minicafe-db",
      "database_id": "07db3dbb-3b7b-4382-8ebd-2c3460c3fea6",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": false },
}
